# Plantilla de ajustes propios de cada equipo. Copiar a machine.env y editar.

# IDE_MCP: si este equipo registra los servidores MCP de IDE (phpstorm, pycharm). Valores: yes | no.
IDE_MCP=no

# Opcionales: URL del servidor MCP de cada IDE (el puerto lo elige el IDE y cambia por equipo).
# Solo se usan con IDE_MCP=yes; si faltan, ese MCP se omite con un aviso.
# PHPSTORM_URL=http://127.0.0.1:64442/stream
# PYCHARM_URL=http://127.0.0.1:64462/stream
