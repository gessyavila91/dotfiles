{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/notifyutil -p dev.teebe.agent"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/gitflow-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/estado-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/estado-session.sh"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/estado-session.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/notifyutil -p dev.teebe.agent"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-subagent-reminder"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/notifyutil -p dev.teebe.agent"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'n=$1; shift; [ -x \"$n\" ] || n=$(command -v node) || exit 0; exec \"$n\" \"$@\"' ccdeck-hook '/usr/local/bin/node' '{{HOME}}/.claude/agent-dag/hook.js' --provider 'claude'",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
